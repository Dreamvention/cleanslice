{
  "mcpServers": {
    "cleanslice-api": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "http://localhost:3333/mcp",
        "--header",
        "Content-Type: application/json"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "cmx-findings": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://api.knoxai.com/sse",
        "--header",
        "api-key: secret-1a8747b0-8876-48b2-878f-6f5435f0b033"
      ],
      "env": {
        "API_KEY": "secret-1a8747b0-8876-48b2-878f-6f5435f0b033"
      }
    }
  }
}
